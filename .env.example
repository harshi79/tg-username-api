# ---------------------------------------------------------------------------
# Telegram Username Intelligence API — environment configuration
# Copy to .env for local development. On Vercel, set these in Project
# Settings -> Environment Variables. None of these are required (sane defaults
# are built in); no Telegram/Fragment credentials are ever needed.
# ---------------------------------------------------------------------------

# Upstream base URLs (override for testing/mirroring)
# TELEGRAM_BASE_URL=https://t.me
# FRAGMENT_BASE_URL=https://fragment.com

# Browser-like User-Agent used for public page lookups
# HTTP_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64; rv:127.0) Gecko/20100101 Firefox/127.0

# HTTP behaviour
# HTTP_TIMEOUT_SECONDS=8          # total per-attempt timeout (1-30)
# HTTP_MAX_ATTEMPTS=3             # attempts incl. retries, exponential backoff (1-5)
# HTTP_BACKOFF_BASE_SECONDS=0.4   # backoff base (seconds)
# HTTP_MAX_REDIRECTS=5

# Bounded concurrency towards upstreams (keep these low on purpose)
# TELEGRAM_CONCURRENCY=4
# FRAGMENT_CONCURRENCY=2
# BULK_CONCURRENCY=5              # how many bulk items resolve simultaneously
# BULK_MAX_USERNAMES=25           # max usernames per bulk request (1-100)

# Result cache (listing/ownership state changes; keep the TTL short)
# CACHE_TTL_SECONDS=300
# CACHE_MAX_ENTRIES=2048

# Optional API security (disabled by default)
# API_KEYS=key1,key2              # when set, X-API-Key header is required on /api/v1/*
# API_KEY_HEADER=X-API-Key
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_REQUESTS_PER_MINUTE=60

# APP_ENV=production
